MONGODB_URI=replace_with_mongodb_atlas_uri
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace-before-first-start

# Student cookies: keep lax for local development and same-site HTTPS hosting.
# Cross-site HTTPS frontend/API hosting requires none; browsers may block third-party cookies.
STUDENT_COOKIE_SAME_SITE=lax
# Optional password-reset email delivery via Resend (leave blank until configured).
STUDENT_RESET_EMAIL_API_KEY=
STUDENT_RESET_EMAIL_FROM=
